{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro-harness.local/schemas/agent-overlay.schema.json",
  "title": "Pro Harness optional specialist overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description", "applies_to", "detect", "skills", "instructions", "capability_widening"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 20, "maxLength": 240 },
    "applies_to": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_any", "dependencies_any"],
      "properties": {
        "files_any": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "dependencies_any": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "terms_any": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true }
      }
    },
    "skills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "instructions": { "type": "array", "items": { "type": "string", "minLength": 12 }, "minItems": 2, "maxItems": 8 },
    "capability_widening": { "const": false }
  }
}

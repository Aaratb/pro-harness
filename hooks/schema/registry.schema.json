{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro-harness.local/hooks/registry.schema.json",
  "title": "Pro Harness lifecycle hook registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hooks"],
  "properties": {
    "schema_version": { "const": 1 },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "workflow", "event", "failure_policy", "steps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
          "workflow": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "event": { "enum": ["before-phase-transition", "before-run-completion"] },
          "failure_policy": { "const": "block" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["script", "arguments"],
              "properties": {
                "script": { "type": "string", "pattern": "^scripts/[a-z0-9-]+\\.mjs$" },
                "arguments": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}

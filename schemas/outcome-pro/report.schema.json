{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:outcome-pro:report:1",
  "title": "Outcome Pro supplied-evidence assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "evaluated_at", "feature", "hypothesis", "release", "evidence", "metrics", "assessment", "content_digest"],
  "properties": {
    "schema": { "const": "outcome-pro/report@1" },
    "run_id": { "$ref": "#/$defs/id" },
    "evaluated_at": { "$ref": "#/$defs/time" },
    "feature": {
      "type": "object", "additionalProperties": false, "required": ["name", "repo"],
      "properties": { "name": { "$ref": "#/$defs/text" }, "repo": { "$ref": "#/$defs/text" } }
    },
    "hypothesis": { "$ref": "#/$defs/text" },
    "release": {
      "type": "object", "additionalProperties": false, "required": ["ref", "released_at", "evidence_ids"],
      "properties": {
        "ref": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
        "released_at": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/time" }] },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "evidence": {
      "type": "array", "maxItems": 80,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256", "kind", "note"],
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/text" }, "sha256": { "$ref": "#/$defs/digest" },
          "kind": { "enum": ["intent", "release", "baseline", "observed", "qualitative"] }, "note": { "$ref": "#/$defs/text" }
        }
      }
    },
    "metrics": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/metric" } },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["measurement", "recommendation", "rationale", "limitations", "causal_claim", "follow_up"],
      "properties": {
        "measurement": { "enum": ["MET", "MISSED", "INSUFFICIENT_EVIDENCE"] },
        "recommendation": { "enum": ["CONTINUE", "ITERATE", "INVESTIGATE", "RETIRE", "INSUFFICIENT_EVIDENCE"] },
        "rationale": { "$ref": "#/$defs/text" }, "limitations": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/text" } },
        "causal_claim": { "const": false },
        "follow_up": {
          "type": "object", "additionalProperties": false, "required": ["kind", "destination", "reason"],
          "properties": {
            "kind": { "enum": ["suspected_defect", "new_capability", "structural_limit", "evidence_gap", "none"] },
            "destination": { "enum": ["review-pro", "feature-pro", "architecture-pro", "collect-evidence", "none"] },
            "reason": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "content_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$", "description": "RFC3339 shape; actual Gregorian dates and supported clock fields are checked by the Outcome validator." },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceIds": { "type": "array", "maxItems": 80, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "cohort", "definition", "window_start", "window_end", "sample_size", "evidence_ids"],
      "properties": {
        "value": { "type": "number" }, "unit": { "$ref": "#/$defs/text" }, "cohort": { "$ref": "#/$defs/text" }, "definition": { "$ref": "#/$defs/text" },
        "window_start": { "$ref": "#/$defs/time" }, "window_end": { "$ref": "#/$defs/time" }, "sample_size": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "role", "target", "baseline", "observed", "sample_policy", "comparability", "caveats"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "role": { "enum": ["primary", "guardrail", "secondary"] },
        "target": {
          "anyOf": [{ "type": "null" }, {
            "type": "object", "additionalProperties": false, "required": ["operator", "value", "unit", "evidence_ids"],
            "properties": { "operator": { "enum": ["gte", "lte"] }, "value": { "type": "number" }, "unit": { "$ref": "#/$defs/text" }, "evidence_ids": { "$ref": "#/$defs/evidenceIds" } }
          }]
        },
        "baseline": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/observation" }] },
        "observed": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/observation" }] },
        "sample_policy": {
          "anyOf": [{ "type": "null" }, {
            "type": "object", "additionalProperties": false, "required": ["minimum_n", "minimum_days", "evidence_ids"],
            "properties": { "minimum_n": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "minimum_days": { "type": "number", "minimum": 0 }, "evidence_ids": { "$ref": "#/$defs/evidenceIds" } }
          }]
        },
        "comparability": {
          "type": "object", "additionalProperties": false, "required": ["status", "reason"],
          "properties": { "status": { "enum": ["COMPARABLE", "NOT_COMPARABLE", "UNKNOWN"] }, "reason": { "$ref": "#/$defs/text" } }
        },
        "caveats": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/text" } }
      }
    }
  }
}


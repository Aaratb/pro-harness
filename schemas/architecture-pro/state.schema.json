{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro-harness.local/schemas/architecture-pro/state.schema.json",
  "title": "Architecture Pro resumable state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "architecture_slug", "architecture_title", "command", "run_id", "mode", "artifact_root", "loaded_contract", "input_fingerprint", "harness_provenance_digest", "current_phase", "phases", "lane_runs", "security_focus_runs", "consent_receipts", "decision_reopens", "transition_log", "outcome_axes", "audit_certification", "design_certification", "artifact_digests", "handoff_digest", "budget_usage", "workflow_trace"],
  "properties": {
    "schema_version": { "const": "architecture-pro/state@1" },
    "architecture_slug": { "$ref": "common.schema.json#/$defs/slug" },
    "architecture_title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "command": { "const": "architecture-pro" },
    "run_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "mode": { "enum": ["AUDIT", "DESIGN", "MIXED", "ADR_ONLY"] },
    "artifact_root": { "$ref": "common.schema.json#/$defs/relative_path" },
    "loaded_contract": { "type": "object" },
    "input_fingerprint": { "type": "object", "required": ["source_fingerprint_digest", "repositories"] },
    "harness_provenance_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "current_phase": { "type": "integer", "minimum": 1, "maximum": 13 },
    "phases": { "type": "object", "minProperties": 13, "maxProperties": 13, "additionalProperties": { "$ref": "common.schema.json#/$defs/phase_status" } },
    "lane_runs": { "type": "object" },
    "security_focus_runs": { "type": "object" },
    "consent_receipts": { "type": "array", "items": { "$ref": "consent-receipt.schema.json" } },
    "decision_reopens": { "type": "integer", "minimum": 0 },
    "transition_log": { "type": "array", "items": { "type": "object" } },
    "outcome_axes": { "type": "object", "required": ["health_grade", "evidence_confidence", "target_attainment"] },
    "audit_certification": { "enum": ["pending", "AUDIT_CERTIFIED", "BLOCKED"] },
    "design_certification": { "enum": ["pending", "DESIGN_CERTIFIED", "BLOCKED"] },
    "artifact_digests": { "type": "object", "additionalProperties": { "$ref": "common.schema.json#/$defs/digest" } },
    "handoff_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "budget_usage": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "workflow_trace": { "type": "object", "required": ["path", "schema", "status", "last_event_id", "validated_at"] }
  }
}

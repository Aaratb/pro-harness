{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro-harness.local/schemas/architecture-pro/finding.schema.json",
  "title": "Architecture Pro finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "lane", "statement", "severity", "confidence", "evidence_ids", "blast_radius", "recommendation", "verification_status"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/identifier" },
    "lane": { "type": "string" },
    "statement": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
    "confidence": { "enum": ["HIGH", "MEDIUM", "LOW", "INSUFFICIENT"] },
    "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
    "blast_radius": { "type": "string", "minLength": 1 },
    "recommendation": { "type": "string", "minLength": 1 },
    "verification_status": { "enum": ["PENDING", "CONFIRMED", "DISPUTED", "REFUTED", "BLOCKED"] }
  }
}

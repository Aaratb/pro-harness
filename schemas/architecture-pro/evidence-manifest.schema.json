{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro-harness.local/schemas/architecture-pro/evidence-manifest.schema.json",
  "title": "Architecture Pro evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "source_fingerprint_digest", "records", "manifest_digest"],
  "properties": {
    "schema_version": { "const": "architecture-pro/evidence-manifest@1" },
    "run_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "source_fingerprint_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "records": { "type": "array", "maxItems": 1000, "items": { "$ref": "evidence.schema.json" } },
    "manifest_digest": { "$ref": "common.schema.json#/$defs/digest" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro-harness.local/schemas/architecture-pro/probe-registry.schema.json",
  "title": "Architecture Pro operator-controlled probe registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "probes"],
  "properties": {
    "schema_version": { "const": "architecture-pro/probe-registry@1" },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "executable", "arguments", "environments", "read_only", "timeout_seconds"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/identifier" },
          "executable": { "type": "string", "minLength": 1 },
          "arguments": { "type": "array", "items": { "type": "string" } },
          "environments": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "read_only": { "const": true },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
        }
      }
    }
  }
}

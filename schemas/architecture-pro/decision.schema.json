{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro-harness.local/schemas/architecture-pro/decision.schema.json",
  "title": "Architecture Pro governed decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "problem", "constraints", "options", "selected_option", "tradeoffs", "dissent", "approvals", "reopen_history"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/identifier" },
    "status": { "enum": ["PROPOSED", "APPROVED", "REJECTED", "REOPENED", "SUPERSEDED"] },
    "problem": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "options": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "summary", "tradeoffs"] } },
    "option_scope": {
      "description": "Evidence and independent-review references required when fewer than three credible options satisfy the hard constraints. References must be verified against actual evidence and a fresh report, not self-certified by field presence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rationale", "rejected_alternatives", "independent_review"],
      "properties": {
        "rationale": { "type": "string", "minLength": 1 },
        "rejected_alternatives": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["summary", "constraint", "evidence_ids"],
            "properties": {
              "summary": { "type": "string", "minLength": 1 },
              "constraint": { "type": "string", "minLength": 1 },
              "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
            }
          }
        },
        "independent_review": {
          "type": "object", "additionalProperties": false,
          "required": ["lane_report_id", "challenger_instance_id"],
          "properties": {
            "lane_report_id": { "$ref": "common.schema.json#/$defs/identifier" },
            "challenger_instance_id": { "$ref": "common.schema.json#/$defs/identifier" }
          }
        }
      }
    },
    "selected_option": { "type": ["string", "null"] },
    "tradeoffs": { "type": "array", "items": { "type": "string" } },
    "dissent": { "type": "array", "items": { "type": "string" } },
    "approvals": { "type": "array", "items": { "type": "object" } },
    "reopen_history": { "type": "array", "items": { "type": "object", "required": ["reason", "evidence_ids"] } }
  },
  "anyOf": [
    { "properties": { "options": { "minItems": 3 } } },
    { "required": ["option_scope"], "properties": { "options": { "maxItems": 2 } } }
  ]
}

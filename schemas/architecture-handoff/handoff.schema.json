{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro-harness.local/schemas/architecture-handoff.schema.json",
  "title": "Architecture feature handoff",
  "description": "A certified digest-bound architecture packet consumed by downstream feature planning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "feature_slug", "mode", "source_run_id", "source_fingerprint",
    "source_fingerprint_digest", "harness_provenance", "harness_provenance_digest",
    "certification_status", "outcome_axes", "decision_ids", "artifact_digests",
    "boundaries", "contract_ids", "fitness_functions", "slices", "risks",
    "required_approvals", "rollback_conditions"
  ],
  "properties": {
    "schema_version": { "const": "architecture-pro/handoff@1" },
    "feature_slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "mode": { "enum": ["audit", "design", "mixed"] },
    "source_run_id": { "$ref": "#/$defs/identifier" },
    "source_fingerprint": {
      "type": "object",
      "minProperties": 1,
      "required": ["schema_version", "repositories"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "repositories": { "type": "array", "minItems": 1, "items": { "type": "object", "minProperties": 1 } }
      }
    },
    "source_fingerprint_digest": { "$ref": "#/$defs/digest" },
    "harness_provenance": {
      "type": "object",
      "minProperties": 1,
      "required": ["schema_version", "command_digest"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "command_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "harness_provenance_digest": { "$ref": "#/$defs/digest" },
    "certification_status": { "enum": ["DESIGN_CERTIFIED", "AUDIT_CERTIFIED", "BLOCKED"] },
    "outcome_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health_grade", "evidence_confidence", "target_attainment"],
      "properties": {
        "health_grade": { "enum": ["A", "B", "C", "D", "F"] },
        "evidence_confidence": { "enum": ["HIGH", "MEDIUM", "LOW", "INSUFFICIENT"] },
        "target_attainment": { "enum": ["PASS", "PARTIAL", "FAIL", "UNVERIFIED", "N/A"] }
      }
    },
    "decision_ids": { "$ref": "#/$defs/identifier_array" },
    "artifact_digests": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "$ref": "#/$defs/relative_path" },
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "boundaries": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/boundary" } },
    "contract_ids": { "$ref": "#/$defs/identifier_array" },
    "fitness_functions": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/fitness" } },
    "slices": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/slice" } },
    "risks": { "$ref": "#/$defs/object_array" },
    "required_approvals": { "$ref": "#/$defs/object_array" },
    "rollback_conditions": { "$ref": "#/$defs/object_array" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$" },
    "relative_path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$" },
    "identifier_array": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "object_array": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
    "boundary": {
      "type": "object",
      "required": ["boundary_id"],
      "properties": { "boundary_id": { "$ref": "#/$defs/identifier" } }
    },
    "fitness": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/identifier" } }
    },
    "slice": {
      "type": "object",
      "required": ["slice_id"],
      "properties": { "slice_id": { "$ref": "#/$defs/identifier" } }
    }
  }
}

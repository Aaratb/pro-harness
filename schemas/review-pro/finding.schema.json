{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro-harness.local/schemas/review-pro/finding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{ "$ref": "state.schema.json#/$defs/reviewBinding" }],
  "required": ["schema_version", "finding_id", "category", "severity", "verification_status", "confidence", "repository_identity", "base_sha", "reviewed_head_sha", "diff_digest", "changed_paths", "affected_paths", "title", "expected", "actual", "trigger", "failure_mechanism", "reachability", "evidence_ids", "impact", "suspected_boundary", "requires_correction", "remediation_direction", "validation_target", "content_digest"],
  "properties": {
    "schema_version": { "const": "review-pro/finding@1" },
    "finding_id": { "type": "string", "pattern": "^RP-[A-Z0-9-]+$" },
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
    "verification_status": { "enum": ["CONFIRMED", "REPRODUCED", "LIKELY", "UNVERIFIED", "REFUTED"] },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "repository_identity": { "type": "string", "minLength": 1, "maxLength": 500 },
    "comparison": { "$ref": "state.schema.json#/$defs/comparison" },
    "local_scope": { "$ref": "state.schema.json#/$defs/localScope" },
    "base_sha": { "type": ["string", "null"] },
    "reviewed_head_sha": { "type": ["string", "null"] },
    "diff_digest": { "$ref": "#/$defs/digest" },
    "changed_paths": { "$ref": "#/$defs/paths" },
    "affected_paths": { "$ref": "#/$defs/paths" },
    "title": { "$ref": "#/$defs/text" },
    "expected": { "$ref": "#/$defs/text" },
    "actual": { "$ref": "#/$defs/text" },
    "trigger": { "$ref": "#/$defs/text" },
    "failure_mechanism": { "$ref": "#/$defs/text" },
    "reachability": { "enum": ["changed-path", "affected-consumer", "pre-existing-context", "unverified"] },
    "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^RPE-[A-Z0-9-]+$" } },
    "impact": { "$ref": "#/$defs/text" },
    "suspected_boundary": { "$ref": "#/$defs/text" },
    "requires_correction": { "type": "boolean" },
    "remediation_direction": { "$ref": "#/$defs/text" },
    "validation_target": { "$ref": "#/$defs/text" },
    "content_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "safePath": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$))(?!.*[\\u0000-\\u001f]).+$" },
    "paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/safePath" } }
  }
}

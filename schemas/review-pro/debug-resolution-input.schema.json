{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro-harness.local/schemas/review-pro/debug-resolution-input.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/flat"
    },
    {
      "$ref": "#/$defs/nested"
    }
  ],
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "snapshotEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "digest", "mode", "index"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "kind": { "enum": ["file", "symlink", "missing", "oversized-file", "unsupported"] },
        "digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "mode": { "enum": ["100644", "100755", "120000", null] },
        "index": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["mode", "oid", "stage"],
            "properties": {
              "mode": { "type": "string", "pattern": "^[0-7]{6}$" },
              "oid": { "$ref": "#/$defs/gitSha" },
              "stage": { "type": "integer", "minimum": 0, "maximum": 3 }
            }
          }
        },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$"
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\u0000-\\u001f\\u007f]).+$"
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/safePath"
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "ledger": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "status": {
      "enum": [
        "RESOLVED",
        "PARTIALLY_RESOLVED",
        "UNRESOLVED",
        "SPEC_DECISION_REQUIRED",
        "ARCHITECTURE_DECISION_REQUIRED",
        "NEW_CAPABILITY_REQUIRED"
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "failureStoryEntry": {
      "type": "object",
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "N/A",
            "UNVERIFIED"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      }
    },
    "flatStory": {
      "type": "object",
      "required": [
        "dependency_unavailable",
        "simultaneous_execution",
        "malicious_input",
        "ten_x_volume"
      ],
      "properties": {
        "dependency_unavailable": {
          "$ref": "#/$defs/failureStoryEntry"
        },
        "simultaneous_execution": {
          "$ref": "#/$defs/failureStoryEntry"
        },
        "malicious_input": {
          "$ref": "#/$defs/failureStoryEntry"
        },
        "ten_x_volume": {
          "$ref": "#/$defs/failureStoryEntry"
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_ids",
        "trace_ids",
        "artifact_paths"
      ],
      "properties": {
        "request_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "trace_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "artifact_paths": {
          "$ref": "#/$defs/paths"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "exit_code",
        "ledger_seq"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ledger_seq": {
          "$ref": "#/$defs/ledger"
        },
        "fresh_pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "exit_code",
        "ledger_seq",
        "name",
        "required"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ledger_seq": {
          "$ref": "#/$defs/ledger"
        },
        "fresh_pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "storyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "status",
        "current_behavior",
        "scenario",
        "evidence_ledger_seq",
        "customer_impact",
        "resource_impact",
        "recovery",
        "protection",
        "missing_protection",
        "experiment",
        "remaining_risk",
        "na_reason",
        "evidence_type"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "N/A",
            "UNVERIFIED"
          ]
        },
        "current_behavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "scenario": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "evidence_ledger_seq": {
          "$ref": "#/$defs/ledger"
        },
        "customer_impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "resource_impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "recovery": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "protection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "missing_protection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "experiment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "remaining_risk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "na_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_type": {
          "enum": [
            "observed",
            "static",
            "modeled",
            "unverified"
          ]
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_unavailable",
        "simultaneous_execution",
        "malicious_input",
        "ten_x_volume"
      ],
      "properties": {
        "dependency_unavailable": {
          "$ref": "#/$defs/storyEntry"
        },
        "simultaneous_execution": {
          "$ref": "#/$defs/storyEntry"
        },
        "malicious_input": {
          "$ref": "#/$defs/storyEntry"
        },
        "ten_x_volume": {
          "$ref": "#/$defs/storyEntry"
        }
      }
    },
    "flat": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "review_id",
        "finding_id",
        "original_handoff_digest",
        "repository",
        "pre_fix_sha",
        "post_fix_sha",
        "diff_mode",
        "diff_digest",
        "changed_files",
        "resolution_status",
        "red_evidence",
        "green_evidence",
        "failure_story",
        "review_acceptance_criteria",
        "content_digest"
      ],
      "properties": {
        "schema": {
          "const": "debug-pro/resolution@1"
        },
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "finding_id": {
          "type": "string",
          "pattern": "^RP-[A-Z0-9-]+$"
        },
        "original_handoff_digest": {
          "$ref": "#/$defs/digest"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pre_fix_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "post_fix_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "diff_mode": {
          "enum": [
            "committed",
            "working-tree"
          ]
        },
        "diff_digest": {
          "$ref": "#/$defs/digest"
        },
        "changed_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safePath"
          }
        },
        "resolution_status": {
          "enum": [
            "RESOLVED",
            "PARTIALLY_RESOLVED",
            "UNRESOLVED",
            "SPEC_DECISION_REQUIRED",
            "ARCHITECTURE_DECISION_REQUIRED",
            "NEW_CAPABILITY_REQUIRED"
          ]
        },
        "red_evidence": {
          "type": "array"
        },
        "green_evidence": {
          "type": "array"
        },
        "failure_story": {
          "$ref": "#/$defs/flatStory"
        },
        "review_acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "source": { "allOf": [false] },
        "target": { "allOf": [false] },
        "proof": { "allOf": [false] },
        "logs_and_traces": {
          "$ref": "#/$defs/logs"
        },
        "recommended_reverification_command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      }
    },
    "nested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "debug_run_id",
        "source",
        "target",
        "status",
        "diagnosis",
        "repair",
        "proof",
        "remaining_risks",
        "review_acceptance_criteria",
        "recommended_command",
        "content_digest"
      ],
      "properties": {
        "schema": {
          "const": "debug-pro/resolution@1"
        },
        "debug_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "review_id",
            "finding_id",
            "handoff_digest"
          ],
          "properties": {
            "kind": {
              "enum": [
                "direct",
                "review-pro"
              ]
            },
            "review_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "finding_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "handoff_digest": {
              "anyOf": [
                {
                  "$ref": "#/$defs/digest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "handoff_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_workspace_root": {
              "type": [
                "string",
                "null"
              ]
            },
            "revalidated_ledger_seq": {
              "$ref": "#/$defs/ledger"
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {
              "properties": {
                "diff_mode": { "enum": ["committed", "working-tree"] },
                "pre_fix_sha": { "$ref": "#/$defs/gitSha" },
                "post_fix_sha": { "$ref": "#/$defs/gitSha" },
                "pre_fix_snapshot_digest": false,
                "initial_snapshot_entries": false,
                "local_scope": false
              }
            },
            {
              "required": ["pre_fix_snapshot_digest", "initial_snapshot_entries"],
              "properties": {
                "diff_mode": { "const": "initial-working-tree" },
                "pre_fix_sha": { "type": "null" },
                "post_fix_sha": { "type": "null" },
                "local_scope": false
              }
            },
            {
              "required": ["pre_fix_snapshot_digest", "initial_snapshot_entries", "local_scope"],
              "properties": {
                "diff_mode": { "const": "local-directory" },
                "pre_fix_sha": { "type": "null" },
                "post_fix_sha": { "type": "null" }
              }
            }
          ],
          "required": [
            "repo",
            "repo_root",
            "pre_fix_sha",
            "post_fix_sha",
            "diff_mode",
            "diff_digest",
            "changed_files",
            "run_relative_path",
            "baseline_files"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "repo_root": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "pre_fix_sha": {
              "anyOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }]
            },
            "post_fix_sha": {
              "anyOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }]
            },
            "diff_mode": {
              "enum": [
                "committed",
                "working-tree",
                "initial-working-tree",
                "local-directory"
              ]
            },
            "local_scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safePath" } },
            "pre_fix_snapshot_digest": { "$ref": "#/$defs/digest" },
            "initial_snapshot_entries": { "type": "array", "items": { "$ref": "#/$defs/snapshotEntry" } },
            "diff_digest": {
              "$ref": "#/$defs/digest"
            },
            "changed_files": {
              "$ref": "#/$defs/paths"
            },
            "run_relative_path": {
              "type": "string",
              "pattern": "^\\.agents/debug/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
            },
            "baseline_files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "$ref": "#/$defs/safePath"
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/digest"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root_cause",
            "causal_tier",
            "confidence",
            "repair_seam",
            "evidence_ledger_seq"
          ],
          "properties": {
            "root_cause": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "causal_tier": {
              "enum": [
              "UNVERIFIED",
              "PLAUSIBLE",
                "CORROBORATED",
                "CONFIRMED"
              ]
            },
            "confidence": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 100
            },
            "repair_seam": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "evidence_ledger_seq": {
              "$ref": "#/$defs/ledger"
            }
          }
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repair_plan_path",
            "regression_test_paths",
            "production_paths",
            "data_repair_paths"
          ],
          "properties": {
            "repair_plan_path": {
              "type": "string"
            },
            "regression_test_paths": {
              "$ref": "#/$defs/paths"
            },
            "production_paths": {
              "$ref": "#/$defs/paths"
            },
            "data_repair_paths": {
              "$ref": "#/$defs/paths"
            }
          }
        },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "red",
            "green",
            "original_reproduction",
            "broader_checks",
            "logs_and_traces",
            "failure_story"
          ],
          "properties": {
            "red": {
              "$ref": "#/$defs/command"
            },
            "green": {
              "$ref": "#/$defs/command"
            },
            "original_reproduction": {
              "$ref": "#/$defs/command"
            },
            "broader_checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/check"
              }
            },
            "logs_and_traces": {
              "$ref": "#/$defs/logs"
            },
            "failure_story": {
              "$ref": "#/$defs/story"
            }
          }
        },
        "remaining_risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "review_acceptance_criteria": {
          "$ref": "#/$defs/criteria"
        },
        "recommended_command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro-harness.local/schemas/review-pro/production-risks.schema.json",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{ "$ref": "state.schema.json#/$defs/reviewBinding" }],
  "required": ["schema_version", "repository_identity", "reviewed_head_sha", "findings_digest", "slots", "content_digest"],
  "properties": {
    "schema_version": { "const": "review-pro/production-risks@1" },
    "repository_identity": { "type": "string", "minLength": 1, "maxLength": 500 },
    "comparison": { "$ref": "state.schema.json#/$defs/comparison" },
    "local_scope": { "$ref": "state.schema.json#/$defs/localScope" },
    "reviewed_head_sha": { "type": ["string", "null"] },
    "findings_digest": { "$ref": "#/$defs/digest" },
    "slots": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/slot" } },
    "content_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "finding_id", "evidence_status", "confidence", "customer_pain_and_blast_radius", "resource_category", "production_scenario", "trigger_or_precondition", "affected_component", "available_log_evidence", "expected_log_or_trace_signature", "containment_recommendation", "permanent_solution_recommendation", "validation_or_acceptance_test", "owner_or_next_action"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
        "finding_id": { "anyOf": [{ "type": "string", "pattern": "^RP-[A-Z0-9-]+$" }, { "type": "null" }] },
        "evidence_status": { "enum": ["CONFIRMED", "REPRODUCED", "LIKELY", "UNVERIFIED", "NO_ADDITIONAL_EVIDENCE_BACKED_RISK"] },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "customer_pain_and_blast_radius": { "$ref": "#/$defs/text" },
        "resource_category": { "$ref": "#/$defs/text" },
        "production_scenario": { "$ref": "#/$defs/text" },
        "trigger_or_precondition": { "$ref": "#/$defs/text" },
        "affected_component": { "$ref": "#/$defs/text" },
        "available_log_evidence": { "$ref": "#/$defs/text" },
        "expected_log_or_trace_signature": { "$ref": "#/$defs/text" },
        "containment_recommendation": { "$ref": "#/$defs/text" },
        "permanent_solution_recommendation": { "$ref": "#/$defs/text" },
        "validation_or_acceptance_test": { "$ref": "#/$defs/text" },
        "owner_or_next_action": { "$ref": "#/$defs/text" }
      }
    }
  }
}

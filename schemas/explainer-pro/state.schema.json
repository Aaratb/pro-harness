{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro-harness.local/schemas/explainer-pro/state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "slug", "mode", "audience", "repository_root", "artifact_root", "current_phase", "current_generation", "source_fingerprint", "loaded_contract", "phases", "capabilities", "invalidated_sections", "doubts", "coverage", "workflow_trace", "transition_log"],
  "properties": {
    "schema_version": { "const": "explainer-pro/state@1" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "mode": { "enum": ["COURSE", "CHANGE", "MIXED"] },
    "audience": { "enum": ["PM", "ENG", "STAFF", "FSB"] },
    "repository_root": { "type": "string", "minLength": 1 },
    "artifact_root": { "type": "string", "minLength": 1 },
    "current_phase": { "type": "integer", "minimum": 1, "maximum": 8 },
    "current_generation": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "source_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "worktree_sha256", "captured_at"],
      "properties": {
        "head": { "type": "string", "minLength": 1 },
        "worktree_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "loaded_contract": { "type": "object" },
    "phases": { "type": "object", "minProperties": 8, "maxProperties": 8, "additionalProperties": { "enum": ["pending", "in_progress", "passed", "skipped", "blocked", "stale"] } },
    "capabilities": { "type": "object", "additionalProperties": { "enum": ["pending", "in_progress", "passed", "skipped", "blocked", "stale"] } },
    "invalidated_sections": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "doubts": { "type": "array", "items": { "$ref": "doubt.schema.json" } },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "limitations", "static_only"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "static_only": { "type": "boolean" }
      }
    },
    "workflow_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path"],
      "properties": {
        "status": { "enum": ["pending", "passed", "degraded", "blocked"] },
        "path": { "const": "run-events.jsonl" }
      }
    },
    "transition_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "reason"],
        "properties": {
          "from": { "type": "integer", "minimum": 1, "maximum": 8 },
          "to": { "type": "integer", "minimum": 1, "maximum": 8 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
